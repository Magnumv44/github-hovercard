{
  "manifest_version": 3,
  "author": "Justineo (justice360@gmail.com)",
  "description": "Neat hovercards for GitHub.",
  "name": "GitHub Hovercard",
  "version": "1.9.4",
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "optional_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "*://justineo.github.io/*"
    ]
  },
  "options_page": "options.html"
}
